     GGML_ASSERT(n_tokens <= n_ctx);
+#ifdef LOCAL_QWEN4EXP_TP_PROBE
+    if (!encode && std::getenv("LOCAL_TP_INCREMENTAL")) {
+        std::vector<float> ret;
+        ret.reserve(n_tokens*n_vocab);
+        for (uint32_t pos = 0; pos < n_tokens;) {
+            common_batch_clear(batch);
+            const uint32_t count = pos == 0 ? std::min(uint32_t(64), n_tokens) : 1;
+            for (uint32_t i = 0; i < count; ++i) {
+                common_batch_add(batch, tokens[pos + i], pos + i, {0}, true);
+            }
+            if (llama_decode(lctx, batch)) {
+                llama_batch_free(batch);
+                throw std::runtime_error("incremental decode failed");
+            }
+            for (uint32_t i = 0; i < count; ++i) {
+                const float * logits = llama_get_logits_ith(lctx, i);
+                ret.insert(ret.end(), logits, logits + n_vocab);
+            }
+            pos += count;
+        }
+        llama_batch_free(batch);
+        return ret;
+    }
+#endif
     for (uint32_t pos = 0; pos < n_tokens; pos++) {
         common_batch_add(batch, tokens[pos], pos, {0}, true);
     }
