+static bool ggml_backend_meta_is_host_view(const ggml_tensor * tensor) {
+    const bool is_view = tensor->op == GGML_OP_VIEW || tensor->op == GGML_OP_RESHAPE ||
+                         tensor->op == GGML_OP_PERMUTE || tensor->op == GGML_OP_TRANSPOSE;
+    return is_view && tensor->view_src != nullptr && tensor->buffer != nullptr &&
+           !ggml_backend_buffer_is_meta(tensor->buffer) && ggml_backend_buffer_is_host(tensor->buffer) &&
+           ggml_backend_buffer_is_host(tensor->view_src->buffer);
+}
+
 static struct ggml_tensor * ggml_backend_meta_buffer_simple_tensor(const struct ggml_tensor * tensor, size_t index) {
+    if (!ggml_backend_buffer_is_meta(tensor->buffer)) {
+        fprintf(stderr, "LOCAL META DIAGNOSTIC: name=%s op=%s buffer=%s view=%s\n", tensor->name, ggml_op_name(tensor->op), tensor->buffer ? ggml_backend_buffer_name(tensor->buffer) : "null", tensor->view_src ? tensor->view_src->name : "null");
+        for (int i = 0; i < GGML_MAX_SRC; ++i) {
+            if (tensor->src[i]) {
+                const auto * src = tensor->src[i];
+                fprintf(stderr, "  src[%d] name=%s op=%s buffer=%s\n", i, src->name, ggml_op_name(src->op), src->buffer ? ggml_backend_buffer_name(src->buffer) : "null");
+            }
+        }
+    }
     GGML_ASSERT(ggml_backend_buffer_is_meta(tensor->buffer));
     ggml_backend_meta_buffer_context * buf_ctx = (ggml_backend_meta_buffer_context *) tensor->buffer->context;
     GGML_ASSERT(index < buf_ctx->bufs.size());
